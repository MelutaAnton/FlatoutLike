  m_Name: LoadingScreenConfig
  m_EditorClassIdentifier: FlatOutLike::FlatOutLike.Data.Configs.Flow.LoadingScreenConfig
  _showSeconds: 0.2
  _hideSeconds: 0.35
  _hintFadeSeconds: 0.15
  _fakeTarget: 0.75
  _fakeSeconds: 2
